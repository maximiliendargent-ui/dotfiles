#!/bin/sh
# Session KDE : lance Noctalia, tire un nouveau fond d'écran (comme sous Hyprland)
# puis l'applique aussi au bureau Plasma pour que les deux restent identiques.
noctalia &
# Réessaie jusqu'à ce que Noctalia réponde (10 s max)
for i in $(seq 50); do
    noctalia msg wallpaper-random >/dev/null 2>&1 && break
    sleep 0.2
done
sleep 0.5
wall=$(noctalia msg wallpaper-get 2>/dev/null)
[ -f "$wall" ] && plasma-apply-wallpaperimage "$wall" >/dev/null 2>&1
# btop et cava ouverts à la connexion, comme sous Hyprland et niri
# Pas de tuiles sous KDE : taille explicite, btop exige au moins 80x24
ghostty --class=dev.btop --window-width=110 --window-height=32 -e btop &
ghostty --class=dev.cava -e cava &
wait
