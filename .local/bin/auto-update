#!/usr/bin/env bash
# Propose les mises à jour à l'ouverture de session (autostart auto-update.desktop).
# S'il y en a, affiche une notification avec un bouton « Mettre à jour » ; un clic
# lance la mise à jour dans Ghostty (~/Projects/shell-maison/bin/mises-a-jour).

# Laisse la session et le Wi-Fi démarrer.
sleep 20

# checkupdates : 0 = mises à jour, 2 = rien, 1 = échec (réseau pas encore prêt).
for _ in {1..30}; do
    repo=$(checkupdates 2>/dev/null)
    [[ $? -ne 1 ]] && break
    sleep 10
done

n=$({ [[ -n $repo ]] && echo "$repo"; paru -Qua; flatpak remote-ls --updates --columns=application; } 2>/dev/null | grep -c .)
[[ $n -gt 0 ]] || exit 0

# -t 0 : la notification reste jusqu'à ce qu'on y réponde ou qu'on la ferme.
choix=$(notify-send -a "Mises à jour" -i system-software-update -t 0 \
    -A update="Mettre à jour" "Mises à jour disponibles" "$n paquet(s) à mettre à jour.")
# Mise à jour dans Ghostty (shell-maison)
[[ $choix == update ]] && exec ~/Projects/shell-maison/bin/mises-a-jour
