#!/usr/bin/env bash
# Mise à jour automatique à l'ouverture de session (autostart auto-update.desktop).
# S'il y a des mises à jour, demande au plugin Noctalia arch-updater de les
# installer en arrière-plan (mot de passe par Polkit, journal et rollback dans son panneau).

# Laisse la session, Noctalia et le Wi-Fi démarrer.
sleep 20

# checkupdates : 0 = mises à jour, 2 = rien, 1 = échec (réseau pas encore prêt).
for _ in {1..30}; do
    checkupdates >/dev/null 2>&1
    rc=$?
    [[ $rc -ne 1 ]] && break
    sleep 10
done

# ponytail: une mise à jour Flatpak seule ne déclenche rien, elle part avec la suivante.
[[ $rc -eq 0 ]] || paru -Qua 2>/dev/null | grep -q . || exit 0

exec noctalia msg plugin yuuto/arch-updater:service all update_background
