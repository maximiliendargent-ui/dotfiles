#!/usr/bin/env python3
"""Vignette du personnage du fond d'écran, pour le logo de fastfetch.

Usage : fastfetch-perso <fond d'écran>   (appelé par fish_greeting)

Le personnage vient des étiquettes Wallhaven de l'image (nom de fichier wallhaven-<id>).
Sa vignette est celle choisie à la main (~/.config/fastfetch/persos/<nom>.png) si elle existe,
sinon son portrait AniList. Dans ~/.cache/fastfetch-perso/, <fond>.png est un lien vers la vignette
du personnage ; un fichier vide veut dire « pas de personnage connu » (on ne redemande pas à
chaque terminal).
"""
import json
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

CACHE = Path.home() / ".cache/fastfetch-perso"
CHOISIES = Path.home() / ".config/fastfetch/persos"
# Étiquettes « Characters » de Wallhaven qui ne désignent personne en particulier
GENERIQUES = {"anime girls", "anime boys", "anime", "original characters", "women", "men"}


def appel(url, donnees=None):
    entetes = {"User-Agent": "fastfetch-perso", **({"Content-Type": "application/json"} if donnees else {})}
    with urllib.request.urlopen(urllib.request.Request(url, donnees, entetes), timeout=20) as r:
        return r.read()


def personnage(fond):
    """Nom du personnage d'après les étiquettes Wallhaven, ou None."""
    ident = re.fullmatch(r"wallhaven-(\w+)\.\w+", fond.name)
    if not ident:
        return None
    try:
        tags = json.loads(appel(f"https://wallhaven.cc/api/v1/w/{ident.group(1)}"))["data"]["tags"]
    except urllib.error.HTTPError as e:
        if e.code in (401, 404):  # image privée ou inconnue : définitif ; le reste se retentera
            return None
        raise
    noms = [t["name"] for t in tags if t["category"] == "Characters" and t["name"].lower() not in GENERIQUES]
    # « Stark (Sousou no Frieren) » → « Stark » : AniList cherche sur le nom seul
    return re.sub(r"\s*\(.*\)$", "", noms[0]) if noms else None


def portrait(nom, sortie):
    """Télécharge le portrait AniList du personnage en PNG ; False s'il est inconnu."""
    # ponytail: premier résultat d'AniList pour ce nom, sans vérifier la série ; croiser avec
    # l'étiquette « Series » si un homonyme sort un jour.
    requete = {"query": "query($s:String){Character(search:$s){image{large}}}", "variables": {"s": nom}}
    try:
        rep = json.loads(appel("https://graphql.anilist.co", json.dumps(requete).encode()))
    except urllib.error.HTTPError as e:
        if e.code != 404:  # AniList répond 404 quand il ne trouve personne
            raise
        return False
    perso = (rep.get("data") or {}).get("Character")
    if not perso:
        return False
    subprocess.run(["magick", "-", f"png:{sortie}"], input=appel(perso["image"]["large"]), check=True)
    return True


def main():
    fond = Path(sys.argv[1])
    sortie = CACHE / (fond.name + ".png")
    if sortie.exists() or sortie.is_symlink():
        return
    CACHE.mkdir(parents=True, exist_ok=True)
    nom = personnage(fond)
    if not nom:
        sortie.write_bytes(b"")
        return
    choisie = CHOISIES / (nom.lower() + ".png")
    auto = CACHE / ("perso-" + nom.lower() + ".png")
    if not choisie.exists() and not auto.exists() and not portrait(nom, auto):
        sortie.write_bytes(b"")
        return
    sortie.symlink_to(choisie if choisie.exists() else auto)


if __name__ == "__main__":
    main()
