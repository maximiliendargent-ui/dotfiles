#!/bin/bash
# Ouvre un panneau Noctalia et le referme dès que la souris sort de sa zone, comme les tiroirs de Caelestia.
# Lancé par les bords actifs de la vue d'ensemble (~/.config/quickshell/overview/shell.qml), Hyprland seulement.
# Usage : noctalia-panel-hover <session|control-center|...>

id=$1
marge=20  # pixels tolérés autour du panneau

# Un seul guetteur à la fois : repasser sur le bord pendant que le panneau est ouvert ne fait rien
exec 9>"$XDG_RUNTIME_DIR/noctalia-panel-hover.lock"
flock -n 9 || exit 0

noctalia msg panel-open "$id" >/dev/null
sleep 0.4  # le temps que le calque du panneau existe

while true; do
    read -r x y w h < <(hyprctl -j layers | jq -r \
        '[.. | objects | select(.namespace == "noctalia-panel")][0] | "\(.x) \(.y) \(.w) \(.h)"')
    [[ $x =~ ^-?[0-9]+$ ]] || exit 0  # panneau déjà fermé (Échap, clic à côté, action choisie)
    IFS=', ' read -r cx cy < <(hyprctl cursorpos)
    if (( cx < x - marge || cx > x + w + marge || cy < y - marge || cy > y + h + marge )); then
        noctalia msg panel-close "$id" >/dev/null
        exit 0
    fi
    sleep 0.15
done
