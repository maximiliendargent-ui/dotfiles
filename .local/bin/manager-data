#!/usr/bin/env python3
"""Données de la fenêtre Manager (~/.config/quickshell/manager) : paquets, en JSON.

Usage :
  manager-data official                   paquets des dépôts officiels
  manager-data installed                  paquets installés explicitement
  manager-data aur-search <texte>         recherche dans l'AUR (API)
  manager-data info <official|aur|installed> <nom>
  manager-data install <official|aur> <nom>   (mot de passe via l'agent Polkit de shell-maison)
  manager-data remove <nom>
"""
import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request

ENV = {**os.environ, "LC_ALL": "C"}  # champs de pacman en anglais, pour pouvoir les lire
AUR_RPC = "https://aur.archlinux.org/rpc/v5"


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, env=ENV, **kw).stdout


def out(data):
    json.dump(data, sys.stdout)


def installed_set():
    return set(run(["pacman", "-Qq"]).split())


# ---- Paquets ----

def official():
    inst, seen, pkgs = installed_set(), set(), []
    for line in run(["expac", "-S", "%r\t%n\t%v\t%d"]).splitlines():
        repo, name, version, desc = (line.split("\t") + [""] * 4)[:4]
        if name in seen:  # premier dépôt qui fournit le paquet, comme pacman
            continue
        seen.add(name)
        pkgs.append({"name": name, "repo": repo, "version": version, "desc": desc,
                     "installed": name in inst, "kind": "official"})
    out(pkgs)


def installed():
    foreign = set(run(["pacman", "-Qqm"]).split())
    explicit = run(["pacman", "-Qqe"]).split()
    pkgs = []
    for line in run(["expac", "-Q", "%n\t%v\t%d\t%N", *explicit]).splitlines():
        name, version, desc, required = (line.split("\t") + [""] * 4)[:4]
        pkgs.append({"name": name, "version": version, "desc": desc, "installed": True,
                     "kind": "installed", "aur": name in foreign, "requiredBy": required.split()})
    out(pkgs)


def aur_get(path):
    with urllib.request.urlopen(AUR_RPC + path, timeout=10) as r:
        return json.load(r).get("results", [])


def aur_search(query):
    if len(query) < 2:
        return out([])
    inst = installed_set()
    try:
        res = aur_get("/search/" + urllib.parse.quote(query) + "?by=name-desc")
    except Exception:
        return out([])
    res.sort(key=lambda p: -(p.get("NumVotes") or 0))
    out([{"name": p["Name"], "version": p.get("Version", ""), "desc": p.get("Description") or "",
          "votes": p.get("NumVotes", 0), "popularity": p.get("Popularity", 0),
          "outOfDate": bool(p.get("OutOfDate")), "installed": p["Name"] in inst, "kind": "aur"}
         for p in res[:60]])


def parse_pacman_info(text):
    info, key = {}, None
    for line in text.splitlines():
        if not line.strip():
            if info:  # une fiche par dépôt : on garde la première, comme pacman
                break
            continue
        if " : " in line and not line.startswith(" "):
            key, _, value = line.partition(" : ")
            key = key.strip()
            info[key] = value.strip()
        elif key and line.startswith(" "):
            info[key] += " " + line.strip()
    return info


def none(v):
    return "" if v in ("None", None) else v


def info(kind, name):
    if kind == "aur":
        try:
            p = aur_get("/info?arg[]=" + urllib.parse.quote(name))[0]
        except Exception:
            return out({"name": name})
        return out({"name": name, "source": "AUR", "version": p.get("Version", ""),
                    "desc": p.get("Description") or "", "url": p.get("URL") or "",
                    "votes": p.get("NumVotes", 0), "popularity": round(p.get("Popularity", 0), 2),
                    "outOfDate": bool(p.get("OutOfDate")), "maintainer": p.get("Maintainer") or "none",
                    "depends": " ".join(p.get("Depends", [])),
                    "installed": name in installed_set()})
    i = parse_pacman_info(run(["pacman", "-Qi" if kind == "installed" else "-Si", name]))
    aur = kind == "installed" and name in set(run(["pacman", "-Qqm"]).split())
    out({"name": name, "source": "AUR" if aur else "Official",
         "repo": i.get("Repository", ""), "version": i.get("Version", ""),
         "desc": i.get("Description", ""), "url": none(i.get("URL", "")),
         "size": i.get("Installed Size", ""), "depends": none(i.get("Depends On", "")),
         "requiredBy": none(i.get("Required By", "")),
         "installed": kind == "installed" or name in installed_set()})


def install(kind, name):
    if kind == "aur":
        cmd = ["paru", "-S", "--aur", "--needed", "--noconfirm", "--skipreview", "--sudo", "pkexec", name]
    else:
        cmd = ["pkexec", "pacman", "-S", "--needed", "--noconfirm", name]
    os.execvpe(cmd[0], cmd, ENV)


def remove(name):
    cmd = ["pkexec", "pacman", "-Rns", "--noconfirm", name]
    os.execvpe(cmd[0], cmd, ENV)


if __name__ == "__main__":
    a = sys.argv[1:]
    cmds = {
        "official": lambda: official(),
        "installed": lambda: installed(),
        "aur-search": lambda: aur_search(" ".join(a[1:])),
        "info": lambda: info(a[1], a[2]),
        "install": lambda: install(a[1], a[2]),
        "remove": lambda: remove(a[1]),
    }
    if not a or a[0] not in cmds:
        sys.exit(__doc__)
    cmds[a[0]]()
