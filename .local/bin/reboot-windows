#!/usr/bin/env bash
# Redémarre directement sous Windows, pour une seule fois : l'UEFI reçoit « BootNext »,
# donc le démarrage suivant revient tout seul à Limine (Linux).
# Le mot de passe demandé par Polkit sert de confirmation.

entry=$(efibootmgr | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} Windows Boot Manager.*/\1/p' | head -n 1)

if [[ -z "$entry" ]]; then
    notify-send -u critical "Redémarrage sous Windows" "Entrée « Windows Boot Manager » introuvable dans l'UEFI."
    exit 1
fi

pkexec efibootmgr --bootnext "$entry" >/dev/null || exit 1
systemctl reboot
