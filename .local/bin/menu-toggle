#!/bin/sh
# Ouvre le menu façon Omarchy (Quickshell), ou le ferme s'il est déjà ouvert.
# Le motif « men[u] » évite que pgrep/pkill se trouvent eux-mêmes.
if pgrep -f 'qs -c men[u]' > /dev/null; then
    pkill -f 'qs -c men[u]'
else
    mkdir -p "$HOME/.local/state/quickshell-menu"
    exec qs -c menu
fi
