[Desktop Entry]
# Copie réduite de /usr/share/applications/steam.desktop : seule la commande change (steam-open ouvre la fenêtre même si Steam tourne déjà)
Type=Application
Name=Steam
Icon=steam
Exec=/home/maximilien/.local/bin/steam-open %U
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
