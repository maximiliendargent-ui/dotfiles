// Accueil du terminal. Les couleurs sont des noms ANSI : elles viennent de la palette
// de Ghostty, que matugen (shell-maison) met à jour selon le fond d'écran.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "CachyOS_small",
    "color": { "1": "blue", "2": "magenta" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" },
    "key": { "width": 6 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "os",       "key": "  ", "format": "{name} {arch}" },
    { "type": "kernel",   "key": "  ", "format": "{release}" },
    { "type": "wm",       "key": "  " },
    { "type": "shell",    "key": "  " },
    { "type": "terminal", "key": "  " },
    { "type": "cpu",      "key": "  ", "format": "{name}" },
    { "type": "gpu",      "key": " 󰢮 ", "format": "{name}" },
    { "type": "memory",   "key": " 󰍛 " },
    { "type": "disk",     "key": " 󰋊 ", "folders": "/" },
    { "type": "packages", "key": " 󰏖 " },
    { "type": "uptime",   "key": " 󰅐 " },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
  ]
}
