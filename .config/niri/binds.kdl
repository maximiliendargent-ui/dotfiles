// Raccourcis portés depuis ~/.config/hypr/config/binds.lua.
// hotkey-overlay-title = "Section: texte" : affiché dans l'aide (Super + K).
// AZERTY belge : niri lie la touche par son symbole sans Maj. Rangée des chiffres :
// 1..9 => ampersand eacute quotedbl apostrophe parenleft section egrave exclam ccedilla, 0 => agrave,
// puis parenright (touche Moins d'un QWERTY) et minus (touche Égal).

binds {
    // ---- LANCEUR ----
    // niri ne sait pas lier « Super seul » : le menu est sur Super + M
    Mod+M               hotkey-overlay-title="Lanceur: Menu" { spawn-sh "~/.local/bin/menu-toggle"; }
    Mod+Space           hotkey-overlay-title="Lanceur: Ouvrir le lanceur" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Alt+Space       hotkey-overlay-title="Lanceur: Ouvrir le lanceur (applications)" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Ctrl+E          hotkey-overlay-title="Lanceur: Emojis" { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Mod+semicolon       hotkey-overlay-title="Lanceur: Emojis" { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Mod+K               hotkey-overlay-title="Lanceur: Aide des raccourcis" { show-hotkey-overlay; }
    Mod+Shift+K         hotkey-overlay-title="Lanceur: Modifier les raccourcis" { spawn-sh "code ~/.config/niri/binds.kdl"; }

    // ---- APPLICATIONS ----
    Mod+T               hotkey-overlay-title="Applications: Terminal" { spawn "ghostty"; }
    Mod+Return          hotkey-overlay-title="Applications: Terminal" { spawn "ghostty"; }
    Mod+Alt+Return      hotkey-overlay-title="Applications: Terminal tmux" { spawn "ghostty" "-e" "tmux" "new" "-A" "-s" "main"; }
    Mod+W               hotkey-overlay-title="Applications: Navigateur" { spawn "firefox"; }
    Mod+Shift+Return    hotkey-overlay-title="Applications: Navigateur" { spawn "firefox"; }
    Mod+Shift+Alt+B     hotkey-overlay-title="Applications: Navigation privée" { spawn "firefox" "--private-window"; }
    Mod+C               hotkey-overlay-title="Applications: Éditeur de code" { spawn "code"; }
    Mod+E               hotkey-overlay-title="Applications: Fichiers" { spawn "dolphin"; }
    Mod+Shift+F         hotkey-overlay-title="Applications: Fichiers" { spawn "dolphin"; }
    Mod+Shift+N         hotkey-overlay-title="Applications: Neovim" { spawn "ghostty" "-e" "nvim"; }
    Mod+Shift+D         hotkey-overlay-title="Applications: Docker (LazyDocker)" { spawn "ghostty" "-e" "lazydocker"; }
    Mod+Ctrl+T          hotkey-overlay-title="Applications: Moniteur système (btop)" { spawn "ghostty" "-e" "btop"; }
    Ctrl+Shift+Escape   hotkey-overlay-title="Applications: Moniteur système (btop)" { spawn "ghostty" "-e" "btop"; }
    Mod+Ctrl+Q          hotkey-overlay-title="Applications: Calculatrice" { spawn "gnome-calculator"; }
    XF86Calculator      { spawn "gnome-calculator"; }

    // ---- IA ----
    Mod+Shift+A         hotkey-overlay-title="IA: Claude" { spawn "google-chrome-stable" "--app=https://claude.ai"; }
    Mod+Ctrl+Shift+A    hotkey-overlay-title="IA: Agent Claude Code" { spawn "ghostty" "--class=dev.ai" "-e" "claude"; }

    // ---- FENÊTRES ----
    Mod+Q               hotkey-overlay-title="Fenêtres: Fermer la fenêtre" { close-window; }
    Ctrl+Alt+Delete     hotkey-overlay-title="Fenêtres: Fermer toutes les fenêtres" { spawn-sh "niri msg -j windows | jq '.[].id' | xargs -I{} niri msg action close-window --id {}"; }
    Mod+F               hotkey-overlay-title="Fenêtres: Plein écran" { fullscreen-window; }
    Mod+Alt+F           hotkey-overlay-title="Fenêtres: Pleine largeur (garde la barre)" { maximize-column; }
    Mod+Shift+T         hotkey-overlay-title="Fenêtres: Flottante / en mosaïque" { toggle-window-floating; }
    Mod+O               hotkey-overlay-title="Fenêtres: Vue d'ensemble" { toggle-overview; }
    Mod+R               hotkey-overlay-title="Fenêtres: Largeur suivante (1/3, 1/2, 2/3)" { switch-preset-column-width; }
    Mod+J               hotkey-overlay-title="Fenêtres: Empiler avec la colonne de gauche / en sortir" { consume-or-expel-window-left; }
    Mod+L               hotkey-overlay-title="Fenêtres: Empiler avec la colonne de droite / en sortir" { consume-or-expel-window-right; }
    Mod+Ctrl+less       hotkey-overlay-title="Fenêtres: Centrer la fenêtre" { center-column; }

    Mod+Left            hotkey-overlay-title="Fenêtres: Aller à la fenêtre de gauche" { focus-column-left; }
    Mod+Right           hotkey-overlay-title="Fenêtres: Aller à la fenêtre de droite" { focus-column-right; }
    Mod+Up              hotkey-overlay-title="Fenêtres: Aller à la fenêtre du dessus" { focus-window-up; }
    Mod+Down            hotkey-overlay-title="Fenêtres: Aller à la fenêtre du dessous" { focus-window-down; }
    Mod+Shift+Left      hotkey-overlay-title="Fenêtres: Déplacer à gauche" { move-column-left; }
    Mod+Shift+Right     hotkey-overlay-title="Fenêtres: Déplacer à droite" { move-column-right; }
    Mod+Shift+Up        hotkey-overlay-title="Fenêtres: Déplacer en haut" { move-window-up; }
    Mod+Shift+Down      hotkey-overlay-title="Fenêtres: Déplacer en bas" { move-window-down; }

    // Super + clic gauche (déplacer) et Super + clic droit (redimensionner) sont intégrés à niri.

    // Redimensionnement au clavier
    Mod+parenright       hotkey-overlay-title="Fenêtres: Réduire la largeur" { set-column-width "-50"; }
    Mod+minus            hotkey-overlay-title="Fenêtres: Augmenter la largeur" { set-column-width "+50"; }
    Mod+Shift+parenright hotkey-overlay-title="Fenêtres: Réduire la hauteur" { set-window-height "-50"; }
    Mod+Shift+minus      hotkey-overlay-title="Fenêtres: Augmenter la hauteur" { set-window-height "+50"; }
    Mod+Alt+parenright   hotkey-overlay-title="Fenêtres: Réduire la largeur (petit pas)" { set-column-width "-10"; }
    Mod+Alt+minus        hotkey-overlay-title="Fenêtres: Augmenter la largeur (petit pas)" { set-column-width "+10"; }
    Mod+Ctrl+parenright  hotkey-overlay-title="Fenêtres: Réduire la largeur (grand pas)" { set-column-width "-150"; }
    Mod+Ctrl+minus       hotkey-overlay-title="Fenêtres: Augmenter la largeur (grand pas)" { set-column-width "+150"; }

    // Alt + Tab / Shift + Alt + Tab : sélecteur de fenêtres récentes intégré à niri.

    // ---- GROUPES (colonnes à onglets) ----
    Mod+G               hotkey-overlay-title="Groupes: Colonne en onglets / empilée" { toggle-column-tabbed-display; }
    Mod+Alt+G           hotkey-overlay-title="Groupes: Sortir la fenêtre de la colonne" { expel-window-from-column; }
    Mod+Ctrl+G          hotkey-overlay-title="Groupes: Ajouter la fenêtre de droite à la colonne" { consume-window-into-column; }
    Mod+Alt+Tab         hotkey-overlay-title="Groupes: Onglet suivant" { focus-window-down; }
    Mod+Alt+Shift+Tab   hotkey-overlay-title="Groupes: Onglet précédent" { focus-window-up; }
    Mod+Ctrl+Right      hotkey-overlay-title="Groupes: Onglet suivant" { focus-window-down; }
    Mod+Ctrl+Left       hotkey-overlay-title="Groupes: Onglet précédent" { focus-window-up; }

    // ---- ESPACES DE TRAVAIL ----
    Mod+ampersand       hotkey-overlay-title="Espaces de travail: Aller à l'espace 1" { focus-workspace 1; }
    Mod+eacute          hotkey-overlay-title="Espaces de travail: Aller à l'espace 2" { focus-workspace 2; }
    Mod+quotedbl        hotkey-overlay-title="Espaces de travail: Aller à l'espace 3" { focus-workspace 3; }
    Mod+apostrophe      hotkey-overlay-title="Espaces de travail: Aller à l'espace 4" { focus-workspace 4; }
    Mod+parenleft       hotkey-overlay-title="Espaces de travail: Aller à l'espace 5" { focus-workspace 5; }
    Mod+section         hotkey-overlay-title="Espaces de travail: Aller à l'espace 6" { focus-workspace 6; }
    Mod+egrave          hotkey-overlay-title="Espaces de travail: Aller à l'espace 7" { focus-workspace 7; }
    Mod+exclam          hotkey-overlay-title="Espaces de travail: Aller à l'espace 8" { focus-workspace 8; }
    Mod+ccedilla        hotkey-overlay-title="Espaces de travail: Aller à l'espace 9" { focus-workspace 9; }
    Mod+agrave          hotkey-overlay-title="Espaces de travail: Aller à l'espace 10" { focus-workspace 10; }

    Mod+Shift+ampersand  hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 1" { move-column-to-workspace 1; }
    Mod+Shift+eacute     hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 2" { move-column-to-workspace 2; }
    Mod+Shift+quotedbl   hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 3" { move-column-to-workspace 3; }
    Mod+Shift+apostrophe hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 4" { move-column-to-workspace 4; }
    Mod+Shift+parenleft  hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 5" { move-column-to-workspace 5; }
    Mod+Shift+section    hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 6" { move-column-to-workspace 6; }
    Mod+Shift+egrave     hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 7" { move-column-to-workspace 7; }
    Mod+Shift+exclam     hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 8" { move-column-to-workspace 8; }
    Mod+Shift+ccedilla   hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 9" { move-column-to-workspace 9; }
    Mod+Shift+agrave     hotkey-overlay-title="Espaces de travail: Envoyer la fenêtre à l'espace 10" { move-column-to-workspace 10; }

    Mod+Shift+Alt+ampersand  hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 1 sans suivre" { move-column-to-workspace 1 focus=false; }
    Mod+Shift+Alt+eacute     hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 2 sans suivre" { move-column-to-workspace 2 focus=false; }
    Mod+Shift+Alt+quotedbl   hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 3 sans suivre" { move-column-to-workspace 3 focus=false; }
    Mod+Shift+Alt+apostrophe hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 4 sans suivre" { move-column-to-workspace 4 focus=false; }
    Mod+Shift+Alt+parenleft  hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 5 sans suivre" { move-column-to-workspace 5 focus=false; }
    Mod+Shift+Alt+section    hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 6 sans suivre" { move-column-to-workspace 6 focus=false; }
    Mod+Shift+Alt+egrave     hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 7 sans suivre" { move-column-to-workspace 7 focus=false; }
    Mod+Shift+Alt+exclam     hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 8 sans suivre" { move-column-to-workspace 8 focus=false; }
    Mod+Shift+Alt+ccedilla   hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 9 sans suivre" { move-column-to-workspace 9 focus=false; }
    Mod+Shift+Alt+agrave     hotkey-overlay-title="Espaces de travail: Envoyer à l'espace 10 sans suivre" { move-column-to-workspace 10 focus=false; }

    Mod+Tab             hotkey-overlay-title="Espaces de travail: Espace suivant" { focus-workspace-down; }
    Mod+Shift+Tab       hotkey-overlay-title="Espaces de travail: Espace précédent" { focus-workspace-up; }
    Mod+Ctrl+Tab        hotkey-overlay-title="Espaces de travail: Dernier espace visité" { focus-workspace-previous; }
    Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Espaces de travail: Espace suivant (molette)" { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title="Espaces de travail: Espace précédent (molette)" { focus-workspace-up; }

    // ---- SYSTÈME ----
    Mod+Escape          hotkey-overlay-title="Système: Menu système (veille, redémarrage…)" { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+Ctrl+L          hotkey-overlay-title="Système: Verrouiller l'écran" { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+L         allow-when-locked=true hotkey-overlay-title="Système: Mise en veille" { spawn "systemctl" "suspend-then-hibernate"; }
    Mod+N               hotkey-overlay-title="Système: Centre de contrôle" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Ctrl+A          hotkey-overlay-title="Système: Panneau son" { spawn-sh "noctalia msg panel-toggle control-center audio"; }
    Mod+Ctrl+B          hotkey-overlay-title="Système: Panneau Bluetooth" { spawn-sh "noctalia msg panel-toggle control-center bluetooth"; }
    Mod+Ctrl+W          hotkey-overlay-title="Système: Panneau réseau" { spawn-sh "noctalia msg panel-toggle control-center network"; }
    Mod+Ctrl+N          hotkey-overlay-title="Système: Veilleuse (lumière chaude)" { spawn-sh "noctalia msg nightlight-toggle"; }
    Mod+Ctrl+I          hotkey-overlay-title="Système: Bloquer / autoriser la mise en veille" { spawn-sh "noctalia msg caffeine-toggle"; }
    Mod+Shift+Space     hotkey-overlay-title="Système: Masquer / afficher la barre" { spawn-sh "noctalia msg bar-toggle"; }
    Mod+Z               hotkey-overlay-title="Système: Réglages de Noctalia" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+V               hotkey-overlay-title="Système: Historique du presse-papiers" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Ctrl+V          hotkey-overlay-title="Système: Historique du presse-papiers" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    // Sortie de secours si Noctalia ne répond pas (niri demande confirmation)
    Ctrl+Alt+BackSpace  hotkey-overlay-title="Système: Quitter niri" { quit; }

    // ---- STYLE ----
    Mod+Ctrl+Space       hotkey-overlay-title="Style: Carrousel de fonds d'écran" { spawn-sh "~/.local/bin/wallpicker-toggle"; }
    Mod+Shift+W          hotkey-overlay-title="Style: Carrousel de fonds d'écran" { spawn-sh "~/.local/bin/wallpicker-toggle"; }
    Mod+Ctrl+Shift+Space hotkey-overlay-title="Style: Sélecteur de fonds d'écran Noctalia" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+BackSpace        hotkey-overlay-title="Style: Transparence de la fenêtre" { toggle-window-rule-opacity; }

    // ---- NOTIFICATIONS ----
    Mod+comma           hotkey-overlay-title="Notifications: Fermer les notifications" { spawn-sh "noctalia msg notification-clear-active"; }
    Mod+Ctrl+comma      hotkey-overlay-title="Notifications: Ne pas déranger" { spawn-sh "noctalia msg notification-dnd-toggle"; }
    Mod+Alt+comma       hotkey-overlay-title="Notifications: Ouvrir la dernière notification" { spawn-sh "noctalia msg notification-invoke-latest"; }
    Mod+Shift+Alt+comma hotkey-overlay-title="Notifications: Historique" { spawn-sh "noctalia msg panel-toggle control-center notifications"; }

    // ---- CAPTURES ----
    Print               hotkey-overlay-title="Captures: Écran entier" { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Mod+Shift+S         hotkey-overlay-title="Captures: Zone de l'écran" { spawn-sh "noctalia msg screenshot-region"; }
    Ctrl+Print          hotkey-overlay-title="Captures: Outil de capture de niri (secours)" { screenshot; }
    Mod+Print           hotkey-overlay-title="Captures: Pipette à couleurs" { spawn "hyprpicker" "-a" "-n"; }
    Mod+Shift+C         hotkey-overlay-title="Captures: Pipette à couleurs" { spawn "hyprpicker" "-a" "-n"; }

    // ---- MÉDIAS ----
    XF86AudioRaiseVolume    allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume    allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute           allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute        allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioPlay           allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause          allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext           allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev           allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    Alt+XF86AudioPlay       allow-when-locked=true hotkey-overlay-title="Médias: Piste suivante (Alt + Lecture)" { spawn-sh "noctalia msg media next"; }
    Alt+Shift+XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Médias: Piste précédente (Alt + Shift + Lecture)" { spawn-sh "noctalia msg media previous"; }
    Mod+Shift+M             allow-when-locked=true hotkey-overlay-title="Médias: Couper / rétablir le son" { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp     allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown   allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
}
