// Session niri : même apparence et mêmes raccourcis que ma session Hyprland (~/.config/hypr).
// niri recharge ce fichier à l'enregistrement ; vérifier avec : niri validate
// Environnement de session (NVIDIA, Qt) : ~/.config/uwsm/env, commun avec Hyprland.

input {
    keyboard {
        xkb {
            layout "be"
        }
        numlock
    }
    mouse {
        accel-profile "flat"
    }
    touchpad {
        tap
        natural-scroll
    }
}

output "HDMI-A-1" {
    mode "1920x1080@165.003"
    scale 1
    position x=0 y=0
    // Comme vrr = 3 dans Hyprland : seulement pour les fenêtres qui le demandent (jeux, plus bas).
    variable-refresh-rate on-demand=true
}

layout {
    // Hyprland : gaps_in 5 (donc 10 entre deux fenêtres) et gaps_out 10.
    gaps 10
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    // Bordure de 2 px ; les couleurs sont remplacées par noctalia.kdl (suivent le fond d'écran).
    border {
        width 2
        active-gradient from="#7aa2f7" to="#bb9af7" angle=45
        inactive-color "#414868"
        urgent-color "#9b0000"
    }

    tab-indicator {
        width 4
        gap 4
        position "top"
        place-within-column
    }
}

// Coins carrés, pas de décorations côté client.
prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

// Les captures passent par Noctalia (presse-papiers, enregistrement sur demande).
screenshot-path "~/Pictures/Screenshots/Capture du %Y-%m-%d %H-%M-%S.png"

// Démarrage (équivalent de hypr/config/autostart.lua). Steam et le reste : ~/.config/autostart.
spawn-at-startup "/usr/lib/pam_kwallet_init"
spawn-at-startup "noctalia"
// Nouveau fond d'écran à chaque connexion : réessaie jusqu'à ce que Noctalia réponde (10 s max)
spawn-sh-at-startup "for i in $(seq 50); do noctalia msg wallpaper-random >/dev/null 2>&1 && break; sleep 0.2; done"
spawn-sh-at-startup "xhost +SI:localuser:root"
// btop et cava ouverts à la connexion, en tuiles
spawn-sh-at-startup "uwsm app -- ghostty --class=dev.btop -e btop"
spawn-sh-at-startup "uwsm app -- ghostty --class=dev.cava -e cava"

// ---------------------------------------------------------------------------
// Règles de fenêtres (équivalent de hypr/config/windowrules.lua)
// ---------------------------------------------------------------------------

// Fenêtres opaques et sans flou, comme dans hypr/config/decorations.lua (opacités à 1, blur désactivé).

// Ombre douce, réservée aux fenêtres flottantes.
window-rule {
    match is-floating=true
    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=4
        color "#0009"
    }
}

// Image dans l'image
window-rule {
    match title="^([Pp]icture[-\\s]?[Ii]n[-\\s]?[Pp]icture)(.*)$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

// Jeux : plein écran, opaques, taux de rafraîchissement variable.
window-rule {
    match app-id="^(steam_app.*|gamescope)$"
    open-fullscreen true
    opacity 1.0
    variable-refresh-rate true
}
window-rule {
    match app-id="^steam$" title="^Friends List$"
    match app-id="^steam$" title="^Launching\\.{3}$"
    open-floating true
}

// Applis flottantes
window-rule {
    match app-id="^.*\\.exe$"
    match app-id="^.*[Ll]auncher.*$"
    match app-id="^org\\.kde\\.keditfiletype$"
    match app-id="^(kvantummanager|qt[56]ct|nwg-look)$"
    match app-id="^(org.pulseaudio.pavucontrol|blueman-manager|nm-applet|nm-connection-editor)$"
    match title="^(Winetricks.*|Protontricks.*)$"
    open-floating true
}
window-rule {
    match app-id="^.*[Cc]alc.*$"
    open-floating true
    default-column-width { fixed 326; }
    default-window-height { fixed 464; }
}
window-rule {
    match app-id="^org\\.kde\\.ark$"
    default-column-width { fixed 768; }
}
window-rule {
    match app-id="^(dev\\.)?(noctalia\\.Noctalia(\\.Settings)?)$"
    open-floating true
    default-column-width { fixed 1344; }
    default-window-height { fixed 756; }
}
window-rule {
    match app-id="^org\\.kde\\.dolphin$"
    exclude title="^(Moving.*|Create New.*|Extract.*|Compress.*|Copying.*|Progress.*|Configure.*|Properties.*|Choose\\sApplication.*)$"
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 594; }
}

// Boîtes de dialogue courantes
window-rule {
    match title="^(Open|Authentication Required|Add Folder to Workspace|Choose Files|Save As|Confirm to replace files|File Operation Progress)$"
    match title="^Open File$"
    match app-id="^[Xx]dg-desktop-portal-gtk$"
    match title="^(File Upload|Choose wallpaper|Library)(.*)$"
    match app-id="^.*dialog.*$"
    match title="^.*dialog.*$"
    open-floating true
}

// Fenêtres d'aide (terminal flottant)
window-rule {
    match app-id="^dev\\.keybinds$"
    open-floating true
    default-column-width { fixed 1056; }
    default-window-height { fixed 702; }
}

// Fenêtre Manager (paquets et plugins) : ~/.config/quickshell/manager
window-rule {
    match app-id="^org\\.quickshell$" title="^Manager$"
    open-floating true
    default-column-width { fixed 1152; }
    default-window-height { fixed 756; }
}

include "binds.kdl"
// Généré par Noctalia à partir du fond d'écran (modèle niri_borders).
include "noctalia.kdl"
