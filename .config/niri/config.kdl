// Niri : portage de ma config Hyprland (~/.config/hypr), avec Noctalia comme shell.
// Niri recharge ce fichier à l'enregistrement. Vérifier la syntaxe : niri validate

include "binds.kdl"

// ---- Entrées ----
input {
    keyboard {
        xkb {
            layout "be"
        }
        numlock
    }

    mouse {
        accel-profile "flat"
    }

    focus-follows-mouse
}

// ---- Écran ----
output "HDMI-A-1" {
    mode "1920x1080@165.003"
    scale 1
    position x=0 y=0
    // Fréquence variable seulement pour les fenêtres qui la demandent (règle des jeux plus bas)
    variable-refresh-rate on-demand=true
}

// ---- Apparence : coins carrés, espacements de 10, bordure de 2 px ----
layout {
    gaps 10
    center-focused-column "never"

    // Transparent pour laisser voir le fond d'écran de Noctalia
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    // Couleurs de secours ; les vraies viennent de noctalia.kdl (suivent le fond d'écran)
    border {
        width 2
        active-gradient from="#7aa2f7" to="#bb9af7" angle=45
        inactive-color "#414868"
    }

    tab-indicator {
        width 4
        gap 4
        place-within-column
    }
}

blur {
    passes 3
}

prefer-no-csd

// Les captures sont gérées par Noctalia
screenshot-path null

cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

// ---- Environnement (équivalent de ~/.config/uwsm/env, que niri ne lit pas) ----
environment {
    BROWSER "firefox"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    GBM_BACKEND "nvidia-drm"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    LIBVA_DRIVER_NAME "nvidia"
    NVD_BACKEND "direct"
}

// ---- Démarrage ----
spawn-at-startup "/usr/lib/pam_kwallet_init"
spawn-at-startup "noctalia"
// Nouveau fond d'écran à chaque connexion : réessaie jusqu'à ce que Noctalia réponde (10 s max)
spawn-sh-at-startup "for i in $(seq 50); do noctalia msg wallpaper-random >/dev/null 2>&1 && break; sleep 0.2; done"
spawn-sh-at-startup "sleep 3; xhost +SI:localuser:root"

debug {
    // Permet à Noctalia d'activer une fenêtre depuis une notification
    honor-xdg-activation-with-invalid-serial
}

// ---- Règles de fenêtres ----

// Transparence et flou comme sous Hyprland : 0.95 active, 0.85 inactive
window-rule {
    opacity 0.95
    background-effect {
        blur true
        xray false
    }
}
window-rule {
    match is-active=false
    opacity 0.85
}

// Opaques : navigateurs, terminaux (ils gèrent leur propre transparence), vidéo et images
window-rule {
    match app-id=r#"^(firefox|zen)$"#
    match app-id=r#"^(kitty|com\.mitchellh\.ghostty|ghostty|[Kk]onsole|Alacritty|dev\.keybinds|dev\.ai)$"#
    match app-id=r#"^(mpv|org\.kde\.haruna|.*plex.*|org\.kde\.gwenview|.*vlc.*)$"#
    opacity 1.0
}

// Jeux : plein écran, opaques, fréquence variable
window-rule {
    match app-id=r#"^(steam_app.*|gamescope)$"#
    open-fullscreen true
    opacity 1.0
    variable-refresh-rate true
}
window-rule {
    match app-id=r#"^steam$"# title=r#"^(Friends List|Launching\.{3})$"#
    open-floating true
}

// Image dans l'image
window-rule {
    match title=r#"^([Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture)(.*)$"#
    open-floating true
    opacity 1.0
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// Fenêtres utilitaires et boîtes de dialogue flottantes
window-rule {
    match app-id=r#"^(kvantummanager|qt[56]ct|nwg-look)$"#
    match app-id=r#"^(org\.pulseaudio\.pavucontrol|blueman-manager|nm-applet|nm-connection-editor)$"#
    match app-id=r#"^org\.kde\.keditfiletype$"#
    match app-id=r#"^[Xx]dg-desktop-portal-gtk$"#
    match app-id=r#"^.*dialog.*$"#
    match app-id=r#"^.*[Ll]auncher.*$"#
    match app-id=r#"^.*\.exe$"#
    match title=r#"^(Winetricks.*|Protontricks.*)$"#
    match title=r#"^(Open|Open File|Authentication Required|Add Folder to Workspace|Choose Files|Save As|Confirm to replace files|File Operation Progress)$"#
    match title=r#"^(File Upload|Choose wallpaper|Library)(.*)$"#
    match title=r#"^.*dialog.*$"#
    open-floating true
}

// Calculatrice
window-rule {
    match app-id=r#"^.*[Cc]alc.*$"#
    open-floating true
    default-column-width { fixed 330; }
    default-window-height { fixed 465; }
}

// Ark
window-rule {
    match app-id=r#"^org\.kde\.ark$"#
    default-column-width { fixed 770; }
    default-window-height { fixed 430; }
}

// Dolphin : fenêtre principale flottante (pas ses boîtes de dialogue)
window-rule {
    match app-id=r#"^org\.kde\.dolphin$"#
    exclude title=r#"^(Moving.*|Create New.*|Extract.*|Compress.*|Copying.*|Progress.*|Configure.*|Properties.*|Choose\sApplication.*)$"#
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 595; }
}

// Réglages de Noctalia
window-rule {
    match app-id=r#"^(dev\.)?noctalia\.Noctalia(\.Settings)?$"#
    open-floating true
    default-column-width { fixed 1344; }
    default-window-height { fixed 756; }
}

// Fenêtre Manager (paquets et plugins) : ~/.config/quickshell/manager
window-rule {
    match app-id=r#"^org\.quickshell$"# title=r#"^Manager$"#
    open-floating true
    default-column-width { fixed 1152; }
    default-window-height { fixed 756; }
}

// ---- Règles de calques Noctalia ----
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace=r#"^noctalia-(bar-.+|notification|dock|panel|attached-panel|osd|window-switcher)$"#
    background-effect {
        blur true
        xray false
    }
}

// Couleurs des bordures générées par Noctalia à partir du fond d'écran (à garder en dernier)
include "noctalia.kdl"
